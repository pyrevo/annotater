{
  "_comment": "Declarative scientific interval examples (canonical 0-based half-open). Each example has a `kind` that fixes which facts it must declare (see KINDS in the generator). Expected values are declared facts: tests/oracle/test_semantic_examples_oracle.py verifies each one against the independent oracle (tests/oracle/reference.py); scripts/generate_semantic_examples.py only displays them in docs. Kind `chromosome_naming` declares chromosome-name normalization facts instead of intervals; they are verified against pinned upstream data (tests/oracle/test_chromosome_semantic_examples.py) and the real normalization (tests/test_chromosome_semantic_examples.py).",
  "examples": [
    {
      "name": "true_overlap",
      "kind": "overlap",
      "query": {"chr": "chr1", "start": 10, "end": 18},
      "annotations": [{"id": "A", "chr": "chr1", "start": 13, "end": 22}],
      "expected": {"overlap": true, "overlap_length": 5, "query_length": 8, "overlap_fraction": 0.625}
    },
    {
      "name": "one_base_overlap",
      "kind": "one_base_overlap",
      "query": {"chr": "chr1", "start": 10, "end": 20},
      "annotations": [{"id": "A", "chr": "chr1", "start": 19, "end": 20}],
      "expected": {"overlap": true, "overlap_length": 1, "query_length": 10, "overlap_fraction": 0.1}
    },
    {
      "name": "touching_intervals",
      "kind": "touching",
      "query": {"chr": "chr1", "start": 10, "end": 20},
      "annotations": [{"id": "A", "chr": "chr1", "start": 20, "end": 25}],
      "expected": {"overlap": false, "overlap_length": 0, "closest_distance": 0}
    },
    {
      "name": "one_base_gap",
      "kind": "closest",
      "query": {"chr": "chr1", "start": 10, "end": 20},
      "annotations": [{"id": "A", "chr": "chr1", "start": 21, "end": 25}],
      "expected": {"overlap": false, "overlap_length": 0, "closest_distance": 1}
    },
    {
      "name": "contains_example",
      "kind": "contains",
      "query": {"chr": "chr1", "start": 10, "end": 24},
      "annotations": [{"id": "A", "chr": "chr1", "start": 14, "end": 20}],
      "expected": {"overlap": true, "overlap_length": 6, "contains": true, "within": false}
    },
    {
      "name": "within_example",
      "kind": "within",
      "query": {"chr": "chr1", "start": 14, "end": 20},
      "annotations": [{"id": "A", "chr": "chr1", "start": 10, "end": 24}],
      "expected": {"overlap": true, "overlap_length": 6, "contains": false, "within": true}
    },
    {
      "name": "min_overlap_on_threshold",
      "kind": "min_overlap",
      "query": {"chr": "chr1", "start": 10, "end": 20},
      "annotations": [{"id": "A", "chr": "chr1", "start": 15, "end": 25}],
      "min_overlap": 0.5,
      "expected": {"overlap": true, "overlap_length": 5, "query_length": 10, "overlap_fraction": 0.5, "min_overlap_pass": true}
    },
    {
      "name": "strand_match",
      "kind": "strand",
      "query": {"chr": "chr1", "start": 10, "end": 20, "strand": "+"},
      "annotations": [{"id": "A", "chr": "chr1", "start": 15, "end": 25, "strand": "+"}],
      "use_strand": true,
      "expected": {"overlap": true, "stranded_match": true}
    },
    {
      "name": "strand_missing",
      "kind": "strand",
      "query": {"chr": "chr1", "start": 10, "end": 20, "strand": "+"},
      "annotations": [{"id": "A", "chr": "chr1", "start": 15, "end": 25}],
      "use_strand": true,
      "expected": {"overlap": true, "stranded_match": false}
    },
    {
      "name": "closest_overlapping",
      "kind": "closest",
      "query": {"chr": "chr1", "start": 10, "end": 20},
      "annotations": [{"id": "A", "chr": "chr1", "start": 14, "end": 24}],
      "expected": {"overlap": true, "overlap_length": 6, "closest_distance": 0}
    },
    {
      "name": "closest_large_gap",
      "kind": "closest",
      "query": {"chr": "chr1", "start": 2, "end": 5},
      "annotations": [{"id": "A", "chr": "chr1", "start": 17, "end": 21}],
      "expected": {"overlap": false, "overlap_length": 0, "closest_distance": 12}
    },
    {
      "name": "closest_tie",
      "kind": "closest_tie",
      "query": {"chr": "chr1", "start": 10, "end": 13},
      "annotations": [
        {"id": "A1", "chr": "chr1", "start": 6, "end": 8},
        {"id": "A2", "chr": "chr1", "start": 15, "end": 17},
        {"id": "A3", "chr": "chr1", "start": 22, "end": 25}
      ],
      "expected": {"candidate_distances": {"A1": 2, "A2": 2, "A3": 9}, "closest_distance": 2, "closest_ties": ["A1", "A2"]}
    },
    {
      "name": "chromosome_accession_identity",
      "kind": "chromosome_naming",
      "assembly": "GRCh38",
      "target": "ucsc",
      "inputs": ["NC_000001.11"],
      "expected": {
        "outcomes": {"NC_000001.11": "renamed"},
        "outputs": {"NC_000001.11": "chr1"}
      }
    },
    {
      "name": "chromosome_hg19_mitochondria",
      "kind": "chromosome_naming",
      "assembly": "hg19",
      "target": "ensembl",
      "inputs": ["chrM", "chrMT"],
      "expected": {
        "outcomes": {"chrM": "no_alias_for_target", "chrMT": "renamed"},
        "outputs": {"chrM": "chrM", "chrMT": "MT"},
        "distinct_sequences": [["chrM", "chrMT"]]
      }
    },
    {
      "name": "chromosome_dm6_non_human",
      "kind": "chromosome_naming",
      "assembly": "dm6",
      "target": "ensembl",
      "inputs": ["chr2L", "chrM"],
      "expected": {
        "outcomes": {"chr2L": "renamed", "chrM": "no_alias_for_target"},
        "outputs": {"chr2L": "2L", "chrM": "chrM"}
      }
    },
    {
      "name": "chromosome_wrong_assembly",
      "kind": "chromosome_naming",
      "assembly": "GRCh38",
      "target": "ucsc",
      "inputs": ["NC_000001.10", "chr2L"],
      "expected": {
        "outcomes": {"NC_000001.10": "unknown", "chr2L": "unknown"},
        "outputs": {"NC_000001.10": "NC_000001.10", "chr2L": "chr2L"},
        "recognized_in_other_assembly": {"NC_000001.10": "hg19", "chr2L": "dm6"}
      }
    },
    {
      "name": "chromosome_many_to_one",
      "kind": "chromosome_naming",
      "assembly": "GRCh38",
      "target": "ucsc",
      "inputs": ["1", "chr1"],
      "expected": {
        "outcomes": {"1": "renamed", "chr1": "unchanged"},
        "outputs": {"1": "chr1", "chr1": "chr1"},
        "collapses": [{"inputs": ["1", "chr1"], "output": "chr1"}]
      }
    },
    {
      "name": "chromosome_coordinates_preserved",
      "kind": "chromosome_naming",
      "assembly": "GRCh38",
      "target": "ucsc",
      "inputs": ["NC_000001.11", "NC_000002.12"],
      "rows": [
        {"chr": "NC_000001.11", "start": 100, "end": 200, "strand": "+", "name": "peak1"},
        {"chr": "NC_000002.12", "start": 0, "end": 50, "strand": "-", "name": "peak2"}
      ],
      "expected": {
        "outcomes": {"NC_000001.11": "renamed", "NC_000002.12": "renamed"},
        "outputs": {"NC_000001.11": "chr1", "NC_000002.12": "chr2"},
        "rows_after": [
          {"chr": "chr1", "start": 100, "end": 200, "strand": "+", "name": "peak1"},
          {"chr": "chr2", "start": 0, "end": 50, "strand": "-", "name": "peak2"}
        ]
      }
    }
  ]
}
